  "voz": {
    "medido": "≈3-4 palabras por segundo en el gancho (contado en los cuadros; mídelo con extraer_estilo.py en el computador)",
    "objetivo": { "palabras_por_seg": [3.0, 3.6], "primera_palabra_s": 0.15 }
  },

  "guion": {
    "estructura": ["gancho: pregunta o 'Si…' que te nombra a ti", "revelación: 'en realidad…'", "por dentro: el mecanismo", "metáfora cotidiana", "vuelta al mecanismo + consecuencia", "dato o consejo", "cierre: comenta <palabra>"],
