    "reglas": { "musica": "no (la pone el editor)", "voz": "al frente, -14 LUFS", "sfx_por_min": [45, 60], "cortes_con_golpe_pct_objetivo": 80 },
    "mapa_sfx": { "transicion": "whoosh", "etiqueta_globo": "pop", "palabra_clave": "tick", "gancho": "impacto", "destello": "brillo", "pulso_neon": "pulso", "cierre": "burbuja" }
