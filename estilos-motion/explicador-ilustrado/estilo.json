      "entrar_zoom": "pasar de afuera a 'por dentro' (piel→folículo, celular→batería)",
      "fundido": "misma escena, otro momento o metáfora suave (0,35 s)",
      "corte_seco": "cambio de idea con golpe de sonido",
      "barrido": "salto a una metáfora (auto en la carretera, ampolletas) 0,22 s con blur 22 px",
      "destello": "paso del tiempo (día/noche) o revelación del dato"
