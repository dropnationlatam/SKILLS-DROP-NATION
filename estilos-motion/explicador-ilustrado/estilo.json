      "sacudida": { "px": 14, "dur_s": 0.35 },
      "entrar_zoom": { "escala_salida": 3.2, "dur_s": 0.45, "ease": "power3.in" }
    }
  },

  "transiciones": {
    "medido_pct": { "fundido": 37, "corte_seco": 35, "barrido_desenfoque": 18, "paso_por_negro": 2, "destello": 2 },
